{
  "name": "coin-rates",
  "version": "2.0.0",
  "description": "Fetch currency exchange rate for coin/fiat currency pairs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "npm run type-check && npm run test:unit",
    "test:unit": "./node_modules/.bin/mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bleskomat/coin-rates-node.git"
  },
  "author": {
    "name": "Charles Hill",
    "email": "chill@degreesofzero.com"
  },
  "contributors": [
    {
      "name": "karliatto",
      "email": "karliatto@protonmail.com"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bleskomat/coin-rates-node/issues"
  },
  "homepage": "https://github.com/bleskomat/coin-rates-node#readme",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^20.19.9",
    "mocha": "10.2.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
